# Home-hosting environment (deploy/home/README.md). Copy to home.env (gitignored) and
# fill in the machine-specific values; start-home.ps1 loads every line into the process.
# Path to a real Audiveris launcher on this machine (no spaces in the path, or use a shim).
AUDIVERIS_CMD=C:/path/to/Audiveris/Audiveris.exe
# The web app origin allowed to call this service.
# Comma-separated when the app lives on more than one origin (production + staging).
CORS_ORIGIN=https://solfascribe.app,https://next-solfascribe.jamesaidooessah.workers.dev
# One conversion at a time — the honest ceiling for a shared home machine.
OMR_CONCURRENCY=1
PORT=8480
# Loopback only: the tunnel dials localhost. (This is also the service's default.)
HOST=127.0.0.1
# Audiveris's own per-run log directory, swept when each run ends (Privacy in the README).
AUDIVERIS_LOG_DIR=C:/Users/<you>/AppData/Roaming/AudiverisLtd/audiveris/log
# The jpackage launcher ignores OMR_JAVA_MAX_HEAP, and JAVA_TOOL_OPTIONS loses to the
# launcher's own -Xmx8G; _JAVA_OPTIONS is parsed after the command line and wins.
_JAVA_OPTIONS=-Xmx6g
